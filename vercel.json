{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "installCommand": "pnpm install --filter @workspace/api-server..."
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "pnpm install --filter @workspace/mockup-sandbox...",
      "buildCommand": "BASE_PATH=/__mockup/ PORT=3000 pnpm run build",
      "outputDirectory": "dist"
    },
    "scratch-analyzer": {
      "root": "artifacts/scratch-analyzer",
      "framework": "vite",
      "installCommand": "pnpm install --filter @workspace/scratch-analyzer...",
      "buildCommand": "BASE_PATH=/ PORT=3000 pnpm run build",
      "outputDirectory": "dist/public"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "scratch-analyzer"
      }
    }
  ]
}
